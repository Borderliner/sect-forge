                    (name: "projectile_penetration_speed_change", field_type: F32, is_key: false, is_filename: false, description: "Ratio of projectile speed retained when it penetrates this entity.", ca_order: 34, is_bitwise: 0, enum_values: {}),
                    (name: "projectile_penetration_resistance", field_type: I32, is_key: false, is_filename: false, description: "Added to the projectile penetration counter. Higher number means this entity can stop projectiles more easily.", ca_order: 33, is_bitwise: 0, enum_values: {}),
