                    (name: "dismember_head_alive_hp_ratio", field_type: F32, is_key: false, is_filename: false, description: "If +ve, this entity can have its head dismembered while still alive. Value is fraction of full hitpoints.", ca_order: 46, is_bitwise: 0, enum_values: {}),
                    (name: "dismember_arms_alive_hp_ratio", field_type: F32, is_key: false, is_filename: false, description: "If +ve, this entity can have its arms dismembered while still alive. Value is fraction of full hitpoints.", ca_order: 45, is_bitwise: 0, enum_values: {}),
