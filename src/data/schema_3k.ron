                    (name: "knock_interrupts_ignore_chance", field_type: I32, is_key: false, is_filename: false, description: "Percentage chance to ignore knock interrupts, after rules application.", ca_order: 29, is_bitwise: 0, enum_values: {}),
                    (name: "soft_collision_offset_z", field_type: F32, is_key: false, is_filename: false, description: "Offset the soft collision volume along the z-axis.", ca_order: 30, is_bitwise: 0, enum_values: {}),
