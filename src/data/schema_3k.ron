                    (name: "min_tracking_ratio", field_type: F32, is_key: false, is_filename: false, description: "Minimum ratio of move speed that an entity can slow down for formed movement", ca_order: 37, is_bitwise: 0, enum_values: {}),
                    (name: "max_tracking_ratio", field_type: F32, is_key: false, is_filename: false, description: "Maximum ratio of move speed that an entity can speed up for formed movement", ca_order: 38, is_bitwise: 0, enum_values: {}),
                    (name: "vfx_filter_id", field_type: I32, is_key: false, is_filename: false, description: "Used to filter effect metadata that should only trigger for some entities and not others, e.g. heroes. The \'id\' field of the metadata must match this id if not 0, to be triggered.", ca_order: 39, is_bitwise: 0, enum_values: {}),
                    (name: "can_cast_projectile", field_type: Boolean, is_key: false, is_filename: false, description: "does this entity cast a projectile spell", ca_order: 40, is_bitwise: 0, enum_values: {}),
