                    (name: "max_elevation", field_type: I32, is_key: false, is_filename: false, description: "This is the maximum angle that the projectile can be fired at. Generally you want it high (max 90 degrees), and above 45. Except for special cases (e.g. cannon). Not used when trajectory is fixed!", ca_order: 10, is_bitwise: 0, enum_values: {}),
                    (name: "muzzle_velocity", field_type: F32, is_key: false, is_filename: false, description: "This describes the speed the projectile launches at (metres per second). If it is negative, the code will calculate this value based on firing at 45 degrees, hitting at the effective range. Not used when trajectory is fixed!", ca_order: 11, is_bitwise: 0, enum_values: {}),
                    (name: "marksmanship_bonus", field_type: F32, is_key: false, is_filename: false, description: "", ca_order: 12, is_bitwise: 0, enum_values: {}),
                    (name: "spread", field_type: F32, is_key: false, is_filename: false, description: "", ca_order: 13, is_bitwise: 0, enum_values: {}),
                    (name: "damage", field_type: I32, is_key: false, is_filename: false, description: "", ca_order: 14, is_bitwise: 0, enum_values: {}),
                    (name: "ap_damage", field_type: I32, is_key: false, is_filename: false, description: "", ca_order: 15, is_bitwise: 0, enum_values: {}),
                    (name: "can_bounce", field_type: Boolean, is_key: false, is_filename: false, description: "", ca_order: 16, is_bitwise: 0, enum_values: {}),
                    (name: "high_air_resistance", field_type: Boolean, is_key: false, is_filename: false, description: "", ca_order: 4, is_bitwise: 0, enum_values: {}),
                    (name: "collision_radius", field_type: F32, is_key: false, is_filename: false, description: "", ca_order: 17, is_bitwise: 0, enum_values: {}),
                    (name: "base_reload_time", field_type: F32, is_key: false, is_filename: false, description: "", ca_order: 18, is_bitwise: 0, enum_values: {}),
                    (name: "calibration_distance", field_type: F32, is_key: false, is_filename: false, description: "", ca_order: 19, is_bitwise: 0, enum_values: {}),
                    (name: "calibration_area", field_type: F32, is_key: false, is_filename: false, description: "", ca_order: 20, is_bitwise: 0, enum_values: {}),
                    (name: "bonus_v_infantry", field_type: I32, is_key: false, is_filename: false, description: "", ca_order: 21, is_bitwise: 0, enum_values: {}),
                    (name: "bonus_v_cavalry", field_type: I32, is_key: false, is_filename: false, description: "", ca_order: 22, is_bitwise: 0, enum_values: {}),
                    (name: "bonus_v_large", field_type: I32, is_key: false, is_filename: false, description: "", ca_order: 23, is_bitwise: 0, enum_values: {}),
                    (name: "projectile_display", field_type: OptionalStringU8, is_key: false, is_filename: false, description: "", ca_order: 24, is_bitwise: 0, enum_values: {}),
                    (name: "overhead_stat_effect", field_type: OptionalStringU8, is_key: false, is_filename: false, description: "", ca_order: 25, is_bitwise: 0, enum_values: {}),
                    (name: "projectile_audio", field_type: OptionalStringU8, is_key: false, is_filename: false, description: "", ca_order: 27, is_bitwise: 0, enum_values: {}),
                    (name: "shockwave_radius", field_type: F32, is_key: false, is_filename: false, description: "", ca_order: 28, is_bitwise: 0, enum_values: {}),
                    (name: "can_damage_buildings", field_type: Boolean, is_key: false, is_filename: false, description: "", ca_order: 29, is_bitwise: 0, enum_values: {}),
                    (name: "contact_stat_effect", field_type: OptionalStringU8, is_key: false, is_filename: false, description: "", ca_order: 26, is_bitwise: 0, enum_values: {}),
                    (name: "is_grapple", field_type: Boolean, is_key: false, is_filename: false, description: "", ca_order: 30, is_bitwise: 0, enum_values: {}),
                    (name: "gravity", field_type: F32, is_key: false, is_filename: false, description: "Use this value to make projectiles be more / less affected by gravity. This is mainly used as a representation of wind resistance, so that projectiels can hang in the air. Negative means to use \'normal\' gravity.", ca_order: 33, is_bitwise: 0, enum_values: {}),
                    (name: "burst_size", field_type: I32, is_key: false, is_filename: false, description: "Number of shots in a single burst (value of 1 means no burst mode)", ca_order: 31, is_bitwise: 0, enum_values: {}),
                    (name: "burst_shot_delay", field_type: F32, is_key: false, is_filename: false, description: "Determines the delay between each shot of the same burst", ca_order: 32, is_bitwise: 0, enum_values: {}),
                    (name: "mass", field_type: F32, is_key: false, is_filename: false, description: "Mass of the projectile.", ca_order: 34, is_bitwise: 0, enum_values: {}),
                    (name: "homing_params", field_type: OptionalStringU8, is_key: false, is_filename: false, description: "Link to projectile_homing_params table.", ca_order: 35, is_bitwise: 0, enum_values: {}),
                    (name: "first_person_params", field_type: OptionalStringU8, is_key: false, is_filename: false, description: "", ca_order: 36, is_bitwise: 0, enum_values: {}),
                    (name: "ignition_amount", field_type: F32, is_key: false, is_filename: false, description: "How much do we contribute to setting things on fire. Also, if this value is greater than 0, this is considered a flaming attack", ca_order: 37, is_bitwise: 0, enum_values: {}),
                    (name: "is_magical", field_type: Boolean, is_key: false, is_filename: false, description: "Are we considered magical, for contextual reasons", ca_order: 38, is_bitwise: 0, enum_values: {}),
                    (name: "can_target_airborne", field_type: Boolean, is_key: false, is_filename: false, description: "Can this projectile target a flying unit", ca_order: 39, is_bitwise: 0, enum_values: {}),
                    (name: "fixed_elevation", field_type: I32, is_key: false, is_filename: false, description: "Elevation of fixed trajectory", ca_order: 40, is_bitwise: 0, enum_values: {}),
                    (name: "projectile_penetration", field_type: OptionalStringU8, is_key: false, is_filename: false, description: "", ca_order: 41, is_bitwise: 0, enum_values: {}),
                    (name: "expiry_range", field_type: I32, is_key: false, is_filename: false, description: "If this value is positive it dictactes the maximum distance a projectile can travel before it expires", ca_order: 42, is_bitwise: 0, enum_values: {}),
                    (name: "is_beam_launch_burst", field_type: Boolean, is_key: false, is_filename: false, description: "Launch beams will attempt to make the vfx match the projectiles travel, and apply a clipping plane when a projectile hits something, culling the projectiles in front", ca_order: 43, is_bitwise: 0, enum_values: {}),
                    (name: "expire_on_impact", field_type: Boolean, is_key: false, is_filename: false, description: "If true, the projectile will expire on impact, and will not stick into, or deflect off the object it hit", ca_order: 44, is_bitwise: 0, enum_values: {}),
                    (name: "can_roll", field_type: Boolean, is_key: false, is_filename: false, description: "Can the projectile roll on the ground", ca_order: 45, is_bitwise: 0, enum_values: {}),
                    (name: "shots_per_volley", field_type: I32, is_key: false, is_filename: false, description: "Usually units shoot 1 hot per volley, but some animations have multiple fire points, such as multi-shot artillery units. Most of the logic isn\'t aware of this, so this field is for reference for those systems", ca_order: 46, is_bitwise: 0, enum_values: {}),
                    (name: "fired_by_mount", field_type: Boolean, is_key: false, is_filename: false, description: "If this flag is on (and the firing entity is a macro entity) the mount will fire, rather than the rider", ca_order: 48, is_bitwise: 0, enum_values: {}),
                    (name: "prefer_central_targets", field_type: Boolean, is_key: false, is_filename: false, description: "Prefer entities nearer the centre of the target (rather than closest in firing arc)", ca_order: 49, is_bitwise: 0, enum_values: {}),
                    (name: "can_damage_vehicles", field_type: Boolean, is_key: false, is_filename: false, description: "", ca_order: 50, is_bitwise: 0, enum_values: {}),
                    (name: "lock_on_multiple_fire_pos", field_type: Boolean, is_key: false, is_filename: false, description: "All projectiles launched from multiple fire positions in the same animation will target the same position", ca_order: 51, is_bitwise: 0, enum_values: {}),
                    (name: "spawn_deployable_on_impact", field_type: OptionalStringU8, is_key: false, is_filename: false, description: "Specify a deployable to spawn when this projectile collides with the ground", ca_order: 52, is_bitwise: 0, enum_values: {}),
                ],
                localised_fields: [],
                localised_key_order: [],
            ),
        ],
